+    private func applyTripProgressTheme() {
+        guard let navigationViewController else { return }
+        let bottomBanner = navigationViewController.navigationView.bottomBannerContainerView
+        let backgroundColor = UIColor(hex: currentTripProgressBarBackgroundColor) ?? .systemBackground
+        let textColor = UIColor(hex: currentTripProgressBarTextColor) ?? .label
+        let secondaryTextColor = UIColor(hex: currentTripProgressBarSecondaryTextColor) ?? textColor
+        bottomBanner.backgroundColor = backgroundColor
+        bottomBanner.recursiveSubviews.forEach { subview in
+            if let label = subview as? UILabel {
+                label.textColor = label.font.pointSize >= 18 ? textColor : secondaryTextColor
+                label.backgroundColor = .clear
+            } else if let button = subview as? UIButton {
+                button.tintColor = textColor
+                button.setTitleColor(textColor, for: .normal)
+                button.backgroundColor = .clear
+            } else if let imageView = subview as? UIImageView {
+                imageView.tintColor = textColor
+                imageView.backgroundColor = .clear
+            } else if subview !== bottomBanner {
+                subview.backgroundColor = .clear
+            }
+        }
+    }
