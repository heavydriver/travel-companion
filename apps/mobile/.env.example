EXPO_PUBLIC_API_BASE_URL=

# Mapbox public token (map read) — https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# for iOS emulator
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# for android emulator
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# if using Expo Go, download ngrok <https://ngrok.com/download/windows>, create an account on ngrok, add ngrok to your system path, add-authtoken for ngrok, then run ngrok http 3000
# EXPO_PUBLIC_API_BASE_URL= ngrok URL

# Phase 5 crash reporting
EXPO_PUBLIC_SENTRY_DSN=